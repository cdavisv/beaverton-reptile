{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://beavertonreptiles.local/schemas/site-content.schema.json",
  "title": "Beaverton Reptiles Site Content",
  "type": "object",
  "required": [
    "site",
    "navigation",
    "pages"
  ],
  "properties": {
    "site": {
      "type": "object",
      "required": [
        "name",
        "primaryPhone",
        "address",
        "hours",
        "primaryCtas"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "primaryPhone": {
          "type": "string",
          "minLength": 1
        },
        "email": {
          "type": "string",
          "format": "email"
        },
        "address": {
          "type": "object",
          "required": [
            "street",
            "city",
            "region",
            "postalCode"
          ],
          "properties": {
            "street": {
              "type": "string"
            },
            "city": {
              "type": "string"
            },
            "region": {
              "type": "string"
            },
            "postalCode": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "hours": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "label",
              "value"
            ],
            "properties": {
              "label": {
                "type": "string"
              },
              "value": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        },
        "socialLinks": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "label",
              "href"
            ],
            "properties": {
              "label": {
                "type": "string"
              },
              "href": {
                "type": "string",
                "format": "uri"
              }
            },
            "additionalProperties": false
          }
        },
        "primaryCtas": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/cta"
          }
        }
      },
      "additionalProperties": false
    },
    "navigation": {
      "type": "object",
      "required": [
        "header",
        "footer"
      ],
      "properties": {
        "header": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/navItem"
          }
        },
        "footer": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/navItem"
          }
        }
      },
      "additionalProperties": false
    },
    "pages": {
      "type": "array",
      "minItems": 11,
      "items": {
        "$ref": "#/$defs/page"
      }
    }
  },
  "$defs": {
    "cta": {
      "type": "object",
      "required": [
        "label",
        "href"
      ],
      "properties": {
        "label": {
          "type": "string"
        },
        "href": {
          "type": "string"
        },
        "variant": {
          "type": "string",
          "enum": [
            "primary",
            "secondary",
            "text"
          ]
        }
      },
      "additionalProperties": false
    },
    "navItem": {
      "type": "object",
      "required": [
        "label",
        "href"
      ],
      "properties": {
        "label": {
          "type": "string"
        },
        "href": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "hero": {
      "type": "object",
      "required": [
        "eyebrow",
        "title",
        "description"
      ],
      "properties": {
        "eyebrow": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "ctas": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/cta"
          }
        }
      },
      "additionalProperties": false
    },
    "section": {
      "type": "object",
      "required": [
        "kind",
        "heading"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "proof-strip",
            "card-grid",
            "feature-list",
            "faq",
            "contact-block",
            "pricing-ranges",
            "cta-banner",
            "rich-text"
          ]
        },
        "heading": {
          "type": "string"
        },
        "body": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "seo": {
      "type": "object",
      "required": [
        "title",
        "description"
      ],
      "properties": {
        "title": {
          "type": "string",
          "maxLength": 70
        },
        "description": {
          "type": "string",
          "maxLength": 170
        },
        "ogImage": {
          "type": "string"
        },
        "schemaTypes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "page": {
      "type": "object",
      "required": [
        "slug",
        "template",
        "hero",
        "sections",
        "seo"
      ],
      "properties": {
        "slug": {
          "type": "string"
        },
        "template": {
          "type": "string",
          "enum": [
            "conversion-landing",
            "authority-detail",
            "support-utility"
          ]
        },
        "hero": {
          "$ref": "#/$defs/hero"
        },
        "sections": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/section"
          }
        },
        "seo": {
          "$ref": "#/$defs/seo"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
